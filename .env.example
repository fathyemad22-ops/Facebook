# انسخ الملف ده لـ .env للتجربة على جهازك بس، وماترفعوش على GitHub أبداً.
# على GitHub القيم دي بتتحط في Settings > Secrets and variables > Actions

# مفتاح Claude API (اختياري لو هتملوا الطابور بطريقة تانية)
ANTHROPIC_API_KEY=

# رقم الصفحة (Page ID) وتوكن الصفحة (Page Access Token)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# بيانات تطبيق ميتا، محتاجينها بس لأمر استخراج التوكن طويل المدى
FB_APP_ID=
FB_APP_SECRET=
